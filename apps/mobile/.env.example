# Copy this file to .env.local and change the values.
# .env.local is ignored by git, so your own address is never pushed.
#
# On a real phone, "localhost" means the phone itself, not your laptop.
# Use your laptop's Wi-Fi IP address instead (run `hostname -I` on Linux).
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
