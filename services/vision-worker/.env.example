# Vision worker configuration.
# Copy this file to .env and fill in real keys. The service starts cleanly
# with every value left blank (it falls back to the stub provider).

# Which provider to use: stub | gemini | groq
VISION_PROVIDER=stub

# Stub-only mode (used when VISION_PROVIDER=stub):
#   safe       - canned safe result
#   unsafe     - canned unsafe result
#   unavailable - canned "could not decide" result
#   error      - raises, to exercise fail-closed behaviour
STUB_MODE=safe

# Hosted vision LLM keys. Leave blank to use the stub provider.
# Never commit real keys: .env is gitignored.
GEMINI_API_KEY=
GROQ_API_KEY=

# Logging level: debug | info | warning | error
LOG_LEVEL=info