{
  "name": "@swafy/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed SWAFY API client generated from docs/contracts/openapi.yaml",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../docs/contracts/openapi.yaml -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
