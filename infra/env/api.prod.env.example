# Copy to infra/env/api.prod.env (git-ignored) and replace every CHANGE_ME.
# Must match infra/prod.env.

DATABASE_URL=postgresql://swafy:CHANGE_ME@db:5432/swafy

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=swafy
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_PUBLIC=public
# The tunnel address (https://<random>.trycloudflare.com). Update it when the tunnel restarts.
S3_PUBLIC_ENDPOINT=https://CHANGE_ME.trycloudflare.com

JWT_SECRET=CHANGE_ME
WORKER_SERVICE_TOKEN=CHANGE_ME

# Only the tunnel address may call the API from a browser.
CORS_ORIGINS=https://CHANGE_ME.trycloudflare.com
AUTO_APPROVE_PHOTOS=false
