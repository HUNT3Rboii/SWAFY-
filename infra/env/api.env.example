# Copy to infra/env/api.env (git-ignored). Used by the `api` service in docker compose.
# Starting point for BE-2: rename or add variables as the API needs.

DATABASE_URL=postgresql://swafy:swafy-dev-password@db:5432/swafy

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=swafy
S3_SECRET_KEY=swafy-dev-password
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_PUBLIC=public
# Address phones use to upload/download photos (presigned URLs).
# On a real phone use your laptop's LAN IP, not localhost.
S3_PUBLIC_ENDPOINT=http://localhost:9000

JWT_SECRET=change-me-dev-only
WORKER_SERVICE_TOKEN=change-me-dev-only

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Dev only: approve photos without the AI check (removed in BE-4).
AUTO_APPROVE_PHOTOS=false
