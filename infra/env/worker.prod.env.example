# Copy to infra/env/worker.prod.env (git-ignored) and replace every CHANGE_ME.

API_BASE_URL=http://api:8000
WORKER_SERVICE_TOKEN=CHANGE_ME

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=swafy
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_PUBLIC=public

GEMINI_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME

# Never stub in production: it approves every photo.
# Until the Gemini adapter exists (AI-2) every photo stays "unavailable" (fail closed).
VISION_PROVIDER=gemini
LOG_LEVEL=info
