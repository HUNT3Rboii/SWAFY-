# Copy to infra/prod.env (git-ignored) and replace every CHANGE_ME.
# Generate passwords with:  openssl rand -base64 32

POSTGRES_DB=swafy
POSTGRES_USER=swafy
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=swafy
MINIO_ROOT_PASSWORD=CHANGE_ME

# Images published by GitHub Actions on every merge to main.
IMAGE_PREFIX=ghcr.io/hunt3rboii/swafy
IMAGE_TAG=latest

# Folder for nightly backups. Use a different disk, or a synced folder
# (OneDrive, Google Drive), so backups survive if this machine dies.
BACKUP_DIR=./backups

WEB_PORT=8080
MAX_UPLOAD_SIZE=10MB
